{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "TubeMind",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TubeMind",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/bridge-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/shared/config.js",
        "src/shared/utils.js",
        "src/shared/textsearch.js",
        "src/shared/settings.js",
        "src/shared/store.js",
        "src/content/core.js",
        "src/content/transcript.js",
        "src/content/modules/focus.js",
        "src/content/modules/player.js",
        "src/content/modules/stats.js",
        "src/content/modules/search.js",
        "src/content/modules/notes.js",
        "src/content/main.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_start"
    }
  ]
}
